# Example nginx site for aptly-webui.
#
# Copy to /etc/nginx/sites-available/aptly-webui (or template via your
# config-management system), edit the placeholders, then enable:
#
#   ln -s ../sites-available/aptly-webui /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# This is the minimal "behind some other auth boundary" version. For the
# oauth2-proxy + reader/writer role-mapping variant, see
# /usr/share/doc/aptly-webui/README.md.

server {
  listen 443 ssl http2;
  server_name aptly.example.internal;

  # ssl_certificate     /etc/letsencrypt/live/<host>/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/<host>/privkey.pem;

  root /usr/share/aptly-webui;
  index index.html;

  # SPA — let the client-side router handle unknown paths.
  location / {
    try_files $uri /index.html;
  }

  # Reverse-proxy /api/ to the aptly daemon. The bearer token is injected
  # here so it never reaches the browser. In an Ansible deployment, template
  # this header from vault rather than committing it to the file.
  location /api/ {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # proxy_set_header Authorization "Bearer xxxxxxxxxxxxxxxxxxxx";

    # Large uploads (.deb packages going into aptly).
    client_max_body_size 256m;
    proxy_request_buffering off;
  }
}
