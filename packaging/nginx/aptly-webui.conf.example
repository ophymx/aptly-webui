# Example nginx site for aptly-webui.
#
# Copy to /etc/nginx/sites-available/aptly-webui (or template via your
# config-management system), edit the placeholders, then enable:
#
#   ln -s ../sites-available/aptly-webui /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# This assumes oauth2-proxy is fronting the site and exposes the user's
# IdP groups on its /oauth2/auth response (run it with --set-xauthrequest
# so X-Auth-Request-{User,Email,Groups} are set). If you're not using an
# auth proxy at all, see the "no auth proxy" note at the bottom of this
# file — strip the auth_request and /api/whoami blocks and the UI will
# default everyone to writer.

# Map IdP groups (comma-separated in X-Auth-Request-Groups) to a stable
# role string. Must live at http {} scope, not inside server {} — keep it
# here, or move to a sibling conf.d snippet that loads before this file.
# Adjust the group name(s) to match your IdP.
map $authed_groups $aptly_role {
  "~\baptly-writers\b"   "writer";
  default                "reader";
}

server {
  listen 443 ssl http2;
  server_name aptly.example.internal;

  # ssl_certificate     /etc/letsencrypt/live/<host>/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/<host>/privkey.pem;

  # Require auth (oauth2-proxy upstream) for everything on this vhost.
  auth_request /oauth2/auth;
  error_page 401 = /oauth2/sign_in;

  # Capture the identity headers oauth2-proxy returns so they're usable
  # below (in /api/whoami and the proxied request headers).
  auth_request_set $authed_user   $upstream_http_x_auth_request_user;
  auth_request_set $authed_email  $upstream_http_x_auth_request_email;
  auth_request_set $authed_groups $upstream_http_x_auth_request_groups;

  root /usr/share/aptly-webui;
  index index.html;

  # SPA — let the client-side router handle unknown paths.
  location / {
    try_files $uri /index.html;
  }

  # Whoami helper the UI calls to render the user chip, decide which
  # write controls to render, and (optionally) wire up a Sign out link.
  # The UI's read of `role` is UX only — the real boundary is the
  # limit_except block below.
  #
  # NOTE on the two-location dance: `return` is processed in nginx's
  # rewrite phase, which runs *before* the access phase where
  # auth_request fires. Inlining `return 200 '...$authed_user...'` in
  # /api/whoami directly would substitute empty strings because the
  # auth subrequest hasn't run yet. The try_files indirection forces
  # entry into the content phase; by the time @whoami's `return` is
  # evaluated, auth_request has populated the variables. The named
  # location disables auth_request to avoid re-firing it on the
  # internal redirect.
  #
  # `signout_url` is a free-form string the SPA renders as a Sign out
  # link. Omit the field entirely to hide the button. Adjust to your
  # auth provider:
  #   oauth2-proxy : /oauth2/sign_out?rd=/
  #   Authelia     : /api/logout
  #   Pomerium     : /_pomerium/sign_out
  location = /api/whoami {
    try_files _ @whoami;
  }
  location @whoami {
    auth_request off;
    default_type application/json;
    return 200 '{"user":"$authed_user","role":"$aptly_role","signout_url":"/oauth2/sign_out?rd=/"}';
  }

  # Reverse-proxy /api/ to the aptly daemon.
  #
  # Security boundary lives here, not in the UI: readers are blocked from
  # any non-GET request regardless of what the UI shows. Aptly uses GET
  # for reads and POST/PUT/DELETE for every mutation, so limit_except on
  # GET/HEAD covers the full write surface.
  #
  # The bearer token (if upstream needs one) is injected here so it never
  # reaches the browser. In Ansible, template this header from vault
  # rather than committing it.
  location /api/ {
    limit_except GET HEAD {
      if ($aptly_role != "writer") {
        return 403;
      }
    }

    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-User $authed_user;
    # proxy_set_header Authorization "Bearer xxxxxxxxxxxxxxxxxxxx";

    # Large uploads (.deb packages going into aptly).
    client_max_body_size 256m;
    proxy_request_buffering off;
  }

  # oauth2-proxy callback and sign-in endpoints.
  location /oauth2/ {
    proxy_pass http://127.0.0.1:4180;
    proxy_set_header Host             $host;
    proxy_set_header X-Real-IP        $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
  }
}

# --- No auth proxy? ---
# Drop the `auth_request` + `auth_request_set` lines, the /api/whoami
# block, the /oauth2/ location, and the map + limit_except. The UI
# defaults to writer when /api/whoami is absent, and nginx will pass
# everything straight through to aptly. Only do this on a trusted
# network — aptly's HTTP API has no auth of its own.
