# Dev-time aptly daemon to proxy /api requests to.
# Copy this file to .env.local and fill in your values.

APTLY_API=https://aptly.example.internal

# Optional. If set, the Vite dev proxy will inject
#   Authorization: Bearer ${APTLY_TOKEN}
# on every request forwarded to APTLY_API. This keeps the token
# server-side; it never ships to the browser.
APTLY_TOKEN=

# Set to 1 to skip TLS verification on the dev proxy. Use only when
# APTLY_API is on a private CA you haven't installed locally.
# Prefer installing the CA into your system trust store instead.
APTLY_INSECURE=
